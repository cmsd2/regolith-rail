{
 "nbformat": 4,
 "nbformat_minor": 5,
 "metadata": {
  "kernelspec": {
   "name": "maxima",
   "display_name": "Maxima",
   "language": "maxima"
  }
 },
 "cells": [
  {
   "cell_type": "code",
   "source": "/* prelude: shared by every checks notebook. Keep in sync with packages/docs/checks/prelude.mac. */\nexpect_equal(name, got, want) :=\n  if is(equal(radcan(ratsimp(got - want)), 0)) then true\n  else error(\"check failed:\", name, \"got\", got, \"want\", want)$\nexpect_close(name, got, want, tol) :=\n  if is(abs(float(got - want)) <= tol) then true\n  else error(\"check failed:\", name, \"got\", float(got), \"want\", float(want), \"tolerance\", tol)$",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* The default newsvendor scenario: demand per day, its weights, and the costs. */\ndemand_values: [5, 10, 15, 20, 25]$\ndemand_weights: [1, 2, 3, 2, 1]$\ndemand_probs: demand_weights / lsum(w, w, demand_weights)$\nn_values: length(demand_values)$\nunit_cost: 2$\nlost_cost: 5$\nshortfall(q) := sum(demand_probs[i] * max(0, demand_values[i] - q), i, 1, n_values)$\nleftover(q) := sum(demand_probs[i] * max(0, q - demand_values[i]), i, 1, n_values)$\nexpected_cost(q) := unit_cost * q + lost_cost * shortfall(q)$\ncdf(q) := sum(if demand_values[i] <= q then demand_probs[i] else 0, i, 1, n_values)$",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: expected-cost */\n/* The expected cost is the purchase plus the lost-demand cost, averaged over demand: the same as costing each outcome and averaging. */\nperiod_cost(q, d) := unit_cost * q + lost_cost * max(0, d - q)$\naveraged: makelist(sum(demand_probs[i] * period_cost(q, demand_values[i]), i, 1, n_values), q, 0, 30)$\nexpect_equal(\"expected-cost\", lsum(abs(e), e, averaged - makelist(expected_cost(q), q, 0, 30)), 0);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: marginal-cost */\n/* One more unit costs the unit cost for certain, and saves the lost-demand cost when demand exceeds the order. */\ngot: makelist(expected_cost(q + 1) - expected_cost(q), q, 0, 29)$\nwant: makelist(unit_cost - lost_cost * (1 - cdf(q)), q, 0, 29)$\nexpect_equal(\"marginal-cost\", lsum(abs(d), d, got - want), 0);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: optimality-condition */\n/* Adding a unit stops paying, c - p (1 - F) >= 0, exactly when the chance F that demand is covered reaches (p - c) / p, since p > 0. */\nexpect_equal(\"optimality-condition\", c - p * (1 - F) - p * (F - (p - c) / p), 0);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: critical-ratio */\nexpect_equal(\"critical-ratio-general\", subst([cu = pp - cc, co = cc], cu / (cu + co)), (pp - cc) / pp);\nexpect_equal(\"critical-ratio\", (lost_cost - unit_cost) / lost_cost, 3/5);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: best-order */\ncosts: makelist(expected_cost(q), q, 0, 30)$\nbest: first(sublist(makelist(q, q, 0, 30), lambda([q], is(expected_cost(q) = lmin(costs)))))$\nexpect_equal(\"best-order\", best, 15);\nexpect_equal(\"cover-at-best\", cdf(15), 2/3);\nexpect_equal(\"cover-below-best\", cdf(14), 1/3);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: best-cost */\nexpect_equal(\"expected-shortfall\", shortfall(15), 20/9);\nexpect_equal(\"best-cost\", expected_cost(15), 370/9);\nexpect_close(\"best-cost-decimal\", expected_cost(15), 41.11, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: cost-either-side */\nexpect_equal(\"cost-at-10\", expected_cost(10), 430/9);\nexpect_equal(\"cost-at-20\", expected_cost(20), 385/9);\nexpect_close(\"cost-at-10-decimal\", expected_cost(10), 47.78, 0.005);\nexpect_close(\"cost-at-20-decimal\", expected_cost(20), 42.78, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: expected-leftover */\nexpect_equal(\"expected-leftover\", leftover(15), 20/9);\nexpect_close(\"expected-leftover-decimal\", leftover(15), 2.22, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: salvage */\n/* With a salvage value s, an unsold unit wastes c - s, and a lost sale still gives up p - c. */\nsalvage_value: 1$\nsalvage_ratio: (lost_cost - unit_cost) / ((lost_cost - unit_cost) + (unit_cost - salvage_value))$\nexpect_equal(\"salvage-ratio\", salvage_ratio, 3/4);\nsalvage_best: first(sublist(demand_values, lambda([v], is(cdf(v) >= salvage_ratio))))$\nexpect_equal(\"salvage-order\", salvage_best, 20);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: normal-demand */\nload(distrib)$\nexpect_close(\"normal-order\", quantile_normal(3/5, 100, 20), 105.07, 0.005);\nexpect_close(\"normal-z\", quantile_normal(3/5, 0, 1), 0.2533, 0.00005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: lost-cost-ten */\n/* With a lost-demand cost of 10 the critical ratio is 4/5, 20 is the smallest order covering that much demand, and its cost sits below 15's and 25's. */\nratio_ten: (10 - unit_cost) / 10$\nexpect_equal(\"ratio-ten\", ratio_ten, 4/5);\nexpect_equal(\"cover-at-twenty\", cdf(20), 8/9);\nexpect_equal(\"cover-at-fifteen-short\", is(cdf(15) < ratio_ten), true);\ncost_ten(q) := unit_cost * q + 10 * shortfall(q)$\nexpect_equal(\"cost-ten-at-twenty\", cost_ten(20), 410/9);\nexpect_equal(\"cost-ten-at-fifteen\", cost_ten(15), 470/9);\nexpect_equal(\"cost-ten-at-twenty-five\", cost_ten(25), 50);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  }
 ]
}
