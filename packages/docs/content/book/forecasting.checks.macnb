{
 "nbformat": 4,
 "nbformat_minor": 5,
 "metadata": {
  "kernelspec": {
   "name": "maxima",
   "display_name": "Maxima",
   "language": "maxima"
  }
 },
 "cells": [
  {
   "cell_type": "code",
   "source": "/* prelude: shared by every checks notebook. Keep in sync with packages/docs/checks/prelude.mac. */\nexpect_equal(name, got, want) :=\n  if is(equal(radcan(ratsimp(got - want)), 0)) then true\n  else error(\"check failed:\", name, \"got\", got, \"want\", want)$\nexpect_close(name, got, want, tol) :=\n  if is(abs(float(got - want)) <= tol) then true\n  else error(\"check failed:\", name, \"got\", float(got), \"want\", float(want), \"tolerance\", tol)$",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* Demand with level a and trend b: D[k] = a + b k. */\nd(k) := a + b * k$",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: moving-average-lag */\n/* The average of the last N days forecasts day k, and trails it by b (N + 1) / 2. */\nma(k, n) := sum(d(k - j), j, 1, n) / n$\nexpect_equal(\"ma-lag\", d(k) - ma(k, n), b * (n + 1) / 2);\nexpect_equal(\"ma-lag-7\", subst([b = 1, n = 7], b * (n + 1) / 2), 4);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: smoothing-weights */\n/* Exponential smoothing weights past days alpha (1 - alpha)^j, which sum to 1 with mean age (1 - alpha) / alpha. */\nassume(alpha > 0, alpha < 1)$\nexpect_equal(\"weights-sum\", ev(sum(alpha * (1 - alpha)^j, j, 0, inf), simpsum), 1);\nexpect_equal(\"mean-age\", ev(sum(j * alpha * (1 - alpha)^j, j, 0, inf), simpsum), (1 - alpha) / alpha);\nexpect_equal(\"mean-age-02\", subst(alpha = 1/5, (1 - alpha) / alpha), 4);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: smoothing-lag */\n/* F[k+1] = alpha D[k] + (1 - alpha) F[k]; the error e = D[k+1] - F[k+1] settles where e = (1 - alpha) e + b. */\nsteady: rhs(first(solve(e = (1 - alpha) * e + b, e)))$\nexpect_equal(\"lag-forecast-day\", steady, b / alpha);\nexpect_equal(\"lag-latest-day\", steady - b, b * (1 - alpha) / alpha);\nexpect_equal(\"lag-02-forecast-day\", subst([b = 1, alpha = 1/5], b / alpha), 5);\nexpect_equal(\"lag-02-latest-day\", subst([b = 1, alpha = 1/5], b * (1 - alpha) / alpha), 4);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: equivalent-average */\n/* A moving average of N days has the same mean age as smoothing when N = 2 / alpha - 1. */\nexpect_equal(\"ma-mean-age\", sum(j, j, 1, n) / n - 1, (n - 1) / 2);\nexpect_equal(\"equivalent-n\", rhs(first(solve((n - 1) / 2 = (1 - alpha) / alpha, n))), 2 / alpha - 1);\nexpect_equal(\"equivalent-n-02\", subst(alpha = 1/5, 2 / alpha - 1), 9);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: holt */\n/* Holt's method starts with no trend. Its one-day-ahead error dies away, while smoothing alone settles at b / alpha. */\nholt_last_error(alpha, beta, days) := block([level: 20.0, trend: 0.0, err: 0],\n  for k: 1 thru days do (\n    forecast: level + trend,\n    actual: 20 + k,\n    err: actual - forecast,\n    new_level: alpha * actual + (1 - alpha) * forecast,\n    trend: beta * (new_level - level) + (1 - beta) * trend,\n    level: new_level),\n  err)$\nexpect_close(\"holt-late-error\", holt_last_error(0.2, 0.1, 200), 0, 0.01);\nses_last_error(alpha, days) := block([f: 20.0, err: 0],\n  for k: 1 thru days do (err: (20 + k) - f, f: alpha * (20 + k) + (1 - alpha) * f),\n  err)$\nexpect_close(\"ses-late-error\", ses_last_error(0.2, 200), 5, 0.01);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: cover-shortfall */\n/* An order at day k covers days k to k + 2. Demand then is 3 D[k] + 3 b, but the forecast gives 3 (D[k] - b / alpha). */\ncover: 3$\nneeded: sum(d(k + j), j, 0, cover - 1)$\nplanned: cover * (d(k) - b / alpha)$\nexpect_equal(\"shortfall\", needed - planned, cover * b / alpha + b * cover * (cover - 1) / 2);\nexpect_equal(\"shortfall-default\", subst([b = 1, alpha = 1/5], cover * b / alpha + b * cover * (cover - 1) / 2), 18);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: season-average */\n/* Over a whole season of 2 m days, m high at 1 + s and m low at 1 - s, the average factor is 1. */\nexpect_equal(\"season-mean\", (m * (1 + s) + m * (1 - s)) / (2 * m), 1);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: error-measures */\nerrors_example: [2, -1, 3, 0, -2]$\nexpect_equal(\"bias\", lsum(x, x, errors_example) / 5, 2/5);\nexpect_equal(\"mae\", lsum(abs(x), x, errors_example) / 5, 8/5);\nexpect_equal(\"rmse-squared\", lsum(x^2, x, errors_example) / 5, 18/5);\nexpect_close(\"rmse\", sqrt(18/5), 1.90, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: exercise-faster-smoothing */\nexpect_equal(\"alpha-05-lag\", subst([b = 1, alpha = 1/2], b / alpha), 2);\nexpect_equal(\"alpha-05-safety\", subst([b = 1, alpha = 1/2], cover * b / alpha + b * cover * (cover - 1) / 2), 9);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: exercise-ma-lag */\nexpect_equal(\"ma-9-lag\", subst([b = 2, n = 9], b * (n + 1) / 2), 10);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  }
 ]
}
