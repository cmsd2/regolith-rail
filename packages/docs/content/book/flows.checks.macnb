{
 "nbformat": 4,
 "nbformat_minor": 5,
 "metadata": {
  "kernelspec": {
   "name": "maxima",
   "display_name": "Maxima",
   "language": "maxima"
  }
 },
 "cells": [
  {
   "cell_type": "code",
   "source": "/* prelude: shared by every checks notebook. Keep in sync with packages/docs/checks/prelude.mac. */\nexpect_equal(name, got, want) :=\n  if is(equal(radcan(ratsimp(got - want)), 0)) then true\n  else error(\"check failed:\", name, \"got\", got, \"want\", want)$\nexpect_close(name, got, want, tol) :=\n  if is(abs(float(got - want)) <= tol) then true\n  else error(\"check failed:\", name, \"got\", float(got), \"want\", float(want), \"tolerance\", tol)$",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* The two-station line from chapter 1, in hours and units. */\ntau: 4$  t0: 1/6$  t1: 1/60$  kappa: 30$  xbar: 30$\nlam: 36/24$            /* the dome's use, 36 a day, as units an hour */\ncycle(a) := 2 * tau + 2 * (t0 + t1 * a)$\nflow(a) := a / cycle(a)$",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: flow-balance */\n/* Over a stretch of length T, stock changes by what came in less what went out, so the average\n   rates in and out differ by the change in stock over T. Bounded stock makes that difference vanish. */\nkill(xT, x0, T, rin, rout)$\nexpect_equal(\"rates-from-stock\", (x0 + rin * T - rout * T - x0) / T, rin - rout);\n/* With stock between 0 and 30, the rates can differ by at most 30 / T: 3 a day over 10 days. */\nexpect_equal(\"gap-over-10-days\", xbar / 10, 3);\nexpect_equal(\"gap-over-100-days\", xbar / 100, 3/10);\nexpect_equal(\"surplus-per-day\", 45 - 36, 9);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: capacity-bound-proof */\n/* n round trips deliver D <= n kappa and last at least 2 n (tau + t0) + 2 t1 D, so at least D T(kappa) / kappa. */\nkill(D, K, TAU, T0, T1)$\nexpect_equal(\"duration-bound\", D / K * 2 * (TAU + T0) + 2 * T1 * D, D * (2 * TAU + 2 * (T0 + T1 * K)) / K);\n/* A policy that alternates loads of 30 and 10, delivering each in full: its flow is under the bound. */\nloads: [30, 10, 30, 10, 30, 10]$\ndelivered: apply(\"+\", loads)$\nduration: apply(\"+\", map(lambda([l], cycle(l)), loads))$\nexpect_equal(\"alternating-delivered\", delivered, 120);\nexpect_equal(\"alternating-under-bound\", is(delivered / duration <= flow(kappa)), true);\nexpect_equal(\"alternating-trips-bound\", is(length(loads) >= delivered / kappa), true);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: capacity-utilisation */\nexpect_equal(\"full-load-cycle\", cycle(kappa), 28/3);\nexpect_equal(\"capacity-per-day\", 24 * flow(kappa), 540/7);\nexpect_equal(\"utilisation\", lam / flow(kappa), 7/15);\nexpect_close(\"utilisation-decimal\", lam / flow(kappa), 0.47, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: sample-path */\n/* Four units arrive at times a and leave at times d, in hours, over a window of 8. */\na: [0, 1, 2, 5]$  d: [3, 4, 6, 7]$  window: 8$\npresent(t) := length(sublist(makelist(i, i, 1, 4), lambda([i], a[i] <= t and t < d[i])))$\n/* The number present is constant between whole hours, so its integral is a sum over hours. */\narea: sum(present(k + 1/2), k, 0, window - 1)$\nL_avg: area / window$  lam_avg: 4 / window$  W_avg: sum(d[i] - a[i], i, 1, 4) / 4$\nexpect_equal(\"area\", area, 12);\nexpect_equal(\"average-number\", L_avg, 3/2);\nexpect_equal(\"arrival-rate\", lam_avg, 1/2);\nexpect_equal(\"average-time\", W_avg, 3);\nexpect_equal(\"number-present-by-hour\", is(makelist(present(k + 1/2), k, 0, window - 1) = [1, 2, 3, 2, 1, 2, 1, 0]), true);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: littles-law */\nexpect_equal(\"little\", L_avg, lam_avg * W_avg);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: littles-law-area */\n/* The area under the number present is the sum of the times the units spend inside. */\nexpect_equal(\"area-is-total-time\", area, sum(d[i] - a[i], i, 1, 4));\n/* Unit by unit: each contributes its own time inside. */\nfor i: 1 thru 4 do expect_equal(\"unit-time\", sum(if a[i] <= k + 1/2 and k + 1/2 < d[i] then 1 else 0, k, 0, window - 1), d[i] - a[i])$\nexpect_equal(\"area-done\", 1, 1);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: littles-law-sandwich */\n/* At a time when units are present, the area lies between the waits of those departed and of those arrived. */\nupto: 9/2$\narea_upto: sum(present(k/2 + 1/4) / 2, k, 0, 2 * upto - 1)$\ndeparted: sum(if d[i] <= upto then d[i] - a[i] else 0, i, 1, 4)$\narrived: sum(if a[i] <= upto then d[i] - a[i] else 0, i, 1, 4)$\nexpect_equal(\"area-to-4.5\", area_upto, 17/2);\nexpect_equal(\"departed-waits\", departed, 6);\nexpect_equal(\"arrived-waits\", arrived, 10);\nexpect_equal(\"sandwich\", is(departed <= area_upto and area_upto <= arrived), true);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: littles-law-long-run */\n/* Repeat the pattern every 8 hours. Stopping part way through a period, the time average still tends to 3/2. */\naverage_at(k) := (12 * k + area_upto) / (8 * k + upto)$\nexpect_equal(\"after-1-period\", average_at(1), 41/25);\nexpect_close(\"after-10-periods\", average_at(10), 1.5, 0.03);\nexpect_close(\"after-100-periods\", average_at(100), 1.5, 0.003);\nexpect_equal(\"limit\", limit(average_at(k), k, inf), 3/2);\nexpect_equal(\"limit-is-lambda-w\", 3/2, (1/2) * 3);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: balanced-line-formula */\n/* In a cycle with load A, a unit is aboard for the mine stop and one leg, half the cycle. */\nkill(A, TAU, T0, T1, LAM, S)$\nTc: 2 * TAU + 2 * (T0 + T1 * A)$\nexpect_equal(\"aboard-is-half-cycle\", T0 + T1 * A + TAU, Tc / 2);\n/* The three parts add up to the line's stock. */\nexpect_equal(\"parts-sum\", LAM * Tc / 2 + LAM * Tc / 2 + (S - LAM * Tc), S);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: balanced-line */\n/* The mine makes what the dome uses, 3/2 an hour, and the line starts with 15 + 15 units. */\nabar: 250/19$  T: 2 * tau + 2 * (t0 + t1 * abar)$\nexpect_equal(\"round-trip\", T, 500/57);\nexpect_equal(\"load-is-trip-demand\", abar, lam * T);\n/* The mine's stock rises from 0 at lam and is drained every T: a sawtooth averaging lam T / 2. */\nmine: lam * T / 2$\nexpect_equal(\"mine-stock\", mine, 125/19);\nexpect_close(\"mine-stock-decimal\", mine, 6.58, 0.005);\nexpect_close(\"mine-wait\", mine / lam, 4.39, 0.005);\n/* A unit is aboard from loading at the mine stop to unloading on arrival at the dome. */\naboard_time: t0 + t1 * abar + tau$\nexpect_equal(\"aboard-time-is-half-trip\", aboard_time, T / 2);\nexpect_equal(\"aboard\", lam * aboard_time, 125/19);\n/* The dome has what is left of the 30. */\ndome: 30 - mine - lam * aboard_time$\nexpect_equal(\"dome-stock\", dome, 320/19);\nexpect_close(\"dome-stock-decimal\", dome, 16.84, 0.005);\nexpect_equal(\"dome-wait\", dome / lam, 640/57);\nexpect_close(\"dome-wait-decimal\", dome / lam, 11.23, 0.005);\nexpect_equal(\"line-wait\", 30 / lam, 20);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: balanced-line-fast */\n/* The same line with the train at speed 10: two-hour legs. */\nkill(A, TT)$\nfast: solve([A = lam * TT, TT = 2 * 2 + 2 * (t0 + t1 * A)], [A, TT])[1]$\nAf: rhs(fast[1])$  Tf: rhs(fast[2])$\nexpect_equal(\"fast-load\", Af, 130/19);\nexpect_equal(\"fast-trip\", Tf, 260/57);\nexpect_equal(\"fast-mine\", lam * Tf / 2, 65/19);\nexpect_close(\"fast-mine-decimal\", lam * Tf / 2, 3.42, 0.005);\nexpect_equal(\"fast-dome\", 30 - lam * Tf, 440/19);\nexpect_close(\"fast-dome-decimal\", 30 - lam * Tf, 23.16, 0.005);\nexpect_close(\"fast-dome-wait\", (30 - lam * Tf) / lam, 15.44, 0.005);\nexpect_equal(\"fast-line-wait\", 30 / lam, 20);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: relay-roles */\n/* The relay line: legs of 2 hours, four stops a round trip, two of them moving the load; the dome\n   uses 34 a day. Filled at every stop, the dome falls from 30 to 30 - abar and averages 30 - abar / 2. */\nu_r: 34/24$\nkill(A, TT)$\nrel: solve([A = u_r * TT, TT = 4 * 2 + 4 * t0 + 2 * t1 * A], [A, TT])[1]$\nAr: rhs(rel[1])$\nexpect_equal(\"relay-load\", Ar, 4420/343);\nexpect_close(\"relay-load-decimal\", Ar, 12.89, 0.005);\nexpect_close(\"relay-trip\", rhs(rel[2]), 9.10, 0.005);\nexpect_equal(\"relay-dome\", 30 - Ar / 2, 8080/343);\nexpect_close(\"relay-dome-decimal\", 30 - Ar / 2, 23.56, 0.005);\nexpect_close(\"relay-dome-cover\", (30 - Ar / 2) / u_r, 16.63, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: relay-reading */\n/* Reading the 10-day runs with steady demand by Little's law. */\n/* Balancing: stations 44.11, aboard 7.25, delivering 32.86 a day; 13.29 at the junction, 6.27 at the dome. */\nexpect_close(\"balancing-line-stock\", 44.11 + 7.25, 51.36, 0.005);\nexpect_close(\"balancing-line-hours\", (44.11 + 7.25) / 32.86 * 24, 37.5, 0.05);\nexpect_close(\"balancing-junction-hours\", 13.29 / 32.86 * 24, 9.7, 0.05);\nexpect_close(\"balancing-dome-cover\", 6.27 / 32.86 * 24, 4.6, 0.05);\n/* At the dome, a measured wait of 4.53 hours gives lambda W within 2% of the stock. */\nexpect_close(\"dome-lambda-w\", 32.86 * 4.53 / 24, 6.20, 0.005);\nexpect_equal(\"dome-within-2-percent\", is(abs(32.86 * 4.53 / 24 / 6.27 - 1) < 0.02), true);\n/* At the junction, 4.11 a day and a measured wait of 62.9 hours. */\nexpect_close(\"junction-lambda-w-share\", 4.11 * 62.9 / 24 / 13.29, 0.81, 0.005);\n/* Roles: stations 42.98, aboard 21.14, delivering 34 a day; 23.00 at the dome. */\nexpect_close(\"roles-line-stock\", 42.98 + 21.14, 64.12, 0.005);\nexpect_close(\"roles-line-hours\", (42.98 + 21.14) / 34 * 24, 45.3, 0.05);\nexpect_close(\"roles-dome-cover\", 23.00 / 34 * 24, 16.2, 0.05);\n/* The drain-and-fill run has a quarter more stock than the balancing run, and more than three times the cover. */\nexpect_close(\"stock-ratio\", 64.12 / 51.36, 1.25, 0.005);\nexpect_equal(\"cover-ratio-over-three\", is((23.00 / 34) / (6.27 / 32.86) > 3), true);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: exercise-waiting-time */\nexpect_equal(\"waiting-hours\", 12 / 36 * 24, 8);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: exercise-slow-train */\n/* At speed 2 a leg takes 10 hours. */\nTslow: 2 * 10 + 2 * (t0 + kappa * t1)$\nexpect_equal(\"slow-slowest-trip\", Tslow, 64/3);\nexpect_equal(\"slow-greatest-flow\", kappa * 24 / Tslow, 135/4);\nexpect_equal(\"slow-utilisation\", 36 / (kappa * 24 / Tslow), 16/15);\nexpect_close(\"slow-utilisation-decimal\", 36 / (kappa * 24 / Tslow), 1.07, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": "/* check: exercise-less-stock */\n/* Starting with 10 + 10 units on the balanced line. */\nexpect_equal(\"less-line-wait\", 20 / lam, 40/3);\nexpect_close(\"less-line-wait-decimal\", 20 / lam, 13.33, 0.005);\nexpect_equal(\"less-dome\", 20 - lam * T, 130/19);\nexpect_close(\"less-dome-decimal\", 20 - lam * T, 6.84, 0.005);",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  }
 ]
}
